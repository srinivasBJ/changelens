# ChangeLens Environment Configuration - v1.2.0 (Updated: October 24, 2026)
# Evidence-backed change impact layer for AWS operations

# AWS Configuration (us-east-2 production region)
AWS_REGION=us-east-2
AWS_PROFILE=default

# Amazon Bedrock AI Narrative Configuration
BEDROCK_ENABLED=true
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_REGION=us-east-2

# Actionable Remediation & Rollback Engine
REMEDIATION_ENABLED=true
REMEDIATION_DEFAULT_RISK=LOW

# Hindsight Operational Memory Configuration
HINDSIGHT_API_URL=https://api.vectorize.io/v1
HINDSIGHT_API_KEY=your-hindsight-api-key-here
HINDSIGHT_BANK_ID=changelens-operational-memory

# Application Mode: "live" or "demo"
CHANGELENS_MODE=demo

# Backend Server
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_MODE=demo

# Monitored Live Workload Resources
DEMO_FUNCTION_NAME=checkout-function
DEMO_API_NAME=changelens-checkout-api
DEMO_TABLE_NAME=checkout-table
