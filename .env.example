# AWS Configuration
AWS_REGION=us-east-2
AWS_PROFILE=default

# Hindsight Configuration
HINDSIGHT_API_URL=https://api.vectorize.io/v1
HINDSIGHT_API_KEY=your-hindsight-api-key-here
HINDSIGHT_BANK_ID=changelens-operational-memory

# Application Mode: "live" or "demo"
CHANGELENS_MODE=demo

# Backend
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_MODE=demo

# Optional: Bedrock LLM
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# BEDROCK_REGION=us-east-2

# Database (DynamoDB is default, no URL needed)
# DATABASE_URL=postgresql://localhost:5432/changelens

# Demo workload
DEMO_FUNCTION_NAME=changelens-checkout-function
DEMO_API_NAME=changelens-checkout-api
DEMO_TABLE_NAME=changelens-orders
